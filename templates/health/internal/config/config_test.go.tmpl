// managedEnv lists every variable the loader reads, so tests can start from a
// clean slate regardless of what the developer's shell exports.
var managedEnv = []string{
	"APP_ENV", "LOG_LEVEL", "SERVICE_ID", "HTTP_ADDR", "GRPC_ADDR", "HTTP_READ_TIMEOUT", "HTTP_WRITE_TIMEOUT",
	"HTTP_IDLE_TIMEOUT", "HTTP_REQUEST_TIMEOUT", "SHUTDOWN_TIMEOUT",
{{if .HasPostgres}}	"POSTGRES_DSN", "POSTGRES_MAX_CONNS", "POSTGRES_CONN_TIMEOUT",
{{end}}{{if .HasVault}}	"VAULT_ENABLED", "VAULT_ADDR", "VAULT_TOKEN", "VAULT_KV_MOUNT", "VAULT_SECRET_PATH", "VAULT_TIMEOUT",
{{end}}	"OTEL_ENABLED", "OTEL_SERVICE_NAME", "OTEL_SERVICE_VERSION", "OTEL_EXPORTER_OTLP_ENDPOINT",
	"OTEL_EXPORTER_OTLP_INSECURE", "OTEL_TRACES_SAMPLER_ARG",
}

func isolateEnv(t *testing.T, overrides map[string]string) {
	t.Helper()
	for _, key := range managedEnv {
		if original, ok := os.LookupEnv(key); ok {
			t.Cleanup(func() { os.Setenv(key, original) })
			require.NoError(t, os.Unsetenv(key))
		}
	}
	for key, value := range overrides {
		t.Setenv(key, value)
	}
}
{{if .HasVault}}
type stubReader struct {
	secrets map[string]string
	err     error
	calls   int
}

func (s *stubReader) ReadSecrets(context.Context) (map[string]string, error) {
	s.calls++
	return s.secrets, s.err
}
