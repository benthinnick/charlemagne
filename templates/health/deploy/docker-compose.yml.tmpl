name: {{.Name}}

services:
  api:
    build:
      context: ..
      dockerfile: build/Dockerfile
      args:
        VERSION: ${VERSION:-dev}
    ports:
      - "8080:8080"
      - "9091:9090"
    environment:
      APP_ENV: docker
      LOG_LEVEL: info
      SERVICE_ID: {{.ID}}
      HTTP_ADDR: ":8080"
      GRPC_ADDR: ":9090"
{{if .HasPostgres}}
      POSTGRES_DSN: postgres://{{.PostgresUser}}:{{.PostgresPassword}}@postgres:5432/{{.PostgresDB}}?sslmode=disable
      POSTGRES_MAX_CONNS: "8"
{{end}}{{if .HasVault}}
      VAULT_ENABLED: "true"
      VAULT_ADDR: http://vault:8200
      VAULT_TOKEN: ${VAULT_DEV_ROOT_TOKEN:-dev-root-token}
      VAULT_KV_MOUNT: secret
      VAULT_SECRET_PATH: {{.Name}}/config
{{end}}
      OTEL_ENABLED: "true"
      OTEL_SERVICE_NAME: {{.ServiceName}}
      OTEL_SERVICE_VERSION: ${VERSION:-dev}
      OTEL_EXPORTER_OTLP_ENDPOINT: http://jaeger:4317
      OTEL_TRACES_SAMPLER_ARG: "1.0"
    depends_on:
      jaeger:
        condition: service_started
{{if .HasVault}}      vault-seed:
        condition: service_completed_successfully
{{end}}{{if .HasPostgres}}      postgres:
        condition: service_healthy
{{end}}    restart: unless-stopped

  prometheus:
    image: prom/prometheus:v3.5.0
    ports:
      - "9090:9090"
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --web.enable-lifecycle
    depends_on:
      api:
        condition: service_started
    restart: unless-stopped

  jaeger:
    image: jaegertracing/jaeger:2.19.0
    ports:
      - "16686:16686" # UI
      - "4317:4317" # OTLP gRPC
      - "4318:4318" # OTLP HTTP
{{if .HasVault}}
  vault:
    image: hashicorp/vault:1.20
    cap_add:
      - IPC_LOCK
    ports:
      - "8200:8200"
    environment:
      VAULT_DEV_ROOT_TOKEN_ID: ${VAULT_DEV_ROOT_TOKEN:-dev-root-token}
      VAULT_DEV_LISTEN_ADDRESS: 0.0.0.0:8200
    command: server -dev

  vault-seed:
    image: hashicorp/vault:1.20
    depends_on:
      - vault
    environment:
      VAULT_ADDR: http://vault:8200
      VAULT_TOKEN: ${VAULT_DEV_ROOT_TOKEN:-dev-root-token}
    volumes:
      - ./vault/seed.sh:/seed.sh:ro
    entrypoint: ["/bin/sh", "/seed.sh"]
    restart: "no"
{{end}}{{if .HasPostgres}}
  postgres:
    image: postgres:17-alpine
    ports:
      - "5432:5432"
    environment:
      POSTGRES_USER: {{.PostgresUser}}
      POSTGRES_PASSWORD: {{.PostgresPassword}}
      POSTGRES_DB: {{.PostgresDB}}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{.PostgresUser}} -d {{.PostgresDB}}"]
      interval: 2s
      timeout: 5s
      retries: 15
{{end}}
