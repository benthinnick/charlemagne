#!/bin/sh
# Seeds the dev Vault with the secrets the API overlays on top of its
# environment configuration. Runs once per `docker compose up`.
set -eu

echo "waiting for vault at ${VAULT_ADDR}..."
attempt=0
until vault status >/dev/null 2>&1; do
  attempt=$((attempt + 1))
  if [ "${attempt}" -ge 30 ]; then
    echo "vault did not become ready in time" >&2
    exit 1
  fi
  sleep 1
done

vault kv put secret/{{.Name}}/config \
  log_level="info" \
  otel_traces_sampler_arg="1.0"

echo "seeded secret/{{.Name}}/config"
