apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
  namespace: {{.Name}}
  labels:
    app: api
spec:
  replicas: 3
  selector:
    matchLabels:
      app: api
  template:
    metadata:
      labels:
        app: api
    spec:
      initContainers:
        - name: wait-deps
          image: busybox:1.37
          command:
            - /bin/sh
            - -c
            - |
              set -eu
              wait_tcp() {
                host="$1"
                port="$2"
                echo "waiting for ${host}:${port}..."
                until nc -z "${host}" "${port}"; do sleep 1; done
                echo "${host}:${port} is up"
              }
{{if .HasPostgres}}              wait_tcp postgres 5432
{{end}}{{if .HasVault}}              wait_tcp vault 8200
{{end}}              wait_tcp jaeger 4317
{{if .HasVault}}        - name: wait-vault-seed
          image: hashicorp/vault:1.20
          env:
            - name: VAULT_ADDR
              value: http://vault:8200
            - name: VAULT_TOKEN
              valueFrom:
                secretKeyRef:
                  name: {{.Name}}-secrets
                  key: VAULT_TOKEN
          command:
            - /bin/sh
            - -c
            - |
              set -eu
              echo "waiting for vault secret/{{.Name}}/config..."
              attempt=0
              until vault kv get secret/{{.Name}}/config >/dev/null 2>&1; do
                attempt=$((attempt + 1))
                if [ "${attempt}" -ge 60 ]; then
                  echo "vault seed did not become ready in time" >&2
                  exit 1
                fi
                sleep 1
              done
              echo "vault secrets are ready"
{{end}}      containers:
        - name: api
          image: {{.Name}}-api:local
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8080
            - containerPort: 9090
              name: grpc
          env:
            - name: APP_ENV
              value: kubernetes
            - name: LOG_LEVEL
              value: info
            - name: SERVICE_ID
              value: {{.ID}}
            - name: HTTP_ADDR
              value: ":8080"
            - name: GRPC_ADDR
              value: ":9090"
{{if .HasPostgres}}            - name: POSTGRES_DSN
              value: postgres://{{.PostgresUser}}:{{.PostgresPassword}}@postgres:5432/{{.PostgresDB}}?sslmode=disable
            - name: POSTGRES_MAX_CONNS
              value: "8"
{{end}}{{if .HasVault}}            - name: VAULT_ENABLED
              value: "true"
            - name: VAULT_ADDR
              value: http://vault:8200
            - name: VAULT_TOKEN
              valueFrom:
                secretKeyRef:
                  name: {{.Name}}-secrets
                  key: VAULT_TOKEN
            - name: VAULT_KV_MOUNT
              value: secret
            - name: VAULT_SECRET_PATH
              value: {{.Name}}/config
{{end}}            - name: OTEL_ENABLED
              value: "true"
            - name: OTEL_SERVICE_NAME
              value: {{.ServiceName}}
            - name: OTEL_SERVICE_VERSION
              value: local
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: http://jaeger:4317
            - name: OTEL_TRACES_SAMPLER_ARG
              value: "1.0"
          readinessProbe:
            httpGet:
              path: /readyz
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 5
            failureThreshold: 12
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: api
  namespace: {{.Name}}
spec:
  type: NodePort
  selector:
    app: api
  ports:
    - name: http
      port: 8080
      targetPort: 8080
      nodePort: 30080
    - name: grpc
      port: 9090
      targetPort: 9090
      nodePort: 30091
