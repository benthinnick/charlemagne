# Copy to .env and adjust for local (non-Docker) runs: `cp .env.example .env`.
# Every value below is also the built-in default, except where noted.

# --- Application ---------------------------------------------------------
APP_ENV=local
LOG_LEVEL=info
SERVICE_ID={{.ID}}
HTTP_ADDR=:8080
GRPC_ADDR=:9090
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s
{{if .HasPostgres}}
# --- Postgres -------------------------------------------------------------
POSTGRES_DSN=postgres://{{.PostgresUser}}:{{.PostgresPassword}}@localhost:5432/{{.PostgresDB}}?sslmode=disable
POSTGRES_MAX_CONNS=8
POSTGRES_CONN_TIMEOUT=5s
{{end}}{{if .HasVault}}
# --- Vault ----------------------------------------------------------------
# When enabled, values found in Vault override the environment above.
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-root-token
VAULT_KV_MOUNT=secret
VAULT_SECRET_PATH={{.Name}}/config
VAULT_TIMEOUT=5s
{{end}}
# --- Tracing --------------------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME={{.ServiceName}}
OTEL_SERVICE_VERSION=dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_ARG=1.0
