// Command api serves the REST API. This scaffold exposes liveness, readiness,
// and Prometheus metrics; application routes are added later.
package main

import (
	"context"
	"errors"
	"log/slog"
	"net"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"{{.Module}}/internal/config"
	"{{.Module}}/internal/providers"
	"{{.Module}}/internal/server"
	"{{.Module}}/internal/usecase"
	"github.com/benthinnick/distlibs/httpmw"
	"github.com/benthinnick/distlibs/observability"
{{if .HasPostgres}}	"github.com/benthinnick/distlibs/postgres"
{{end}}	"google.golang.org/grpc"
	"google.golang.org/grpc/reflection"
)

// version is stamped at build time via -ldflags "-X main.version=...".
var version = "dev"

func main() {
	if err := run(); err != nil {
		slog.New(slog.NewJSONHandler(os.Stderr, nil)).Error("fatal", slog.Any("error", err))
		os.Exit(1)
	}
}

func run() error {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	cfg, err := config.Load(ctx)
	if err != nil {
		return err
	}
	if cfg.OTel.ServiceVersion == "dev" {
		cfg.OTel.ServiceVersion = version
	}

	logger := observability.NewLogger(os.Stdout, observability.LoggerOptions{
		Level:   cfg.LogLevel,
		Service: cfg.OTel.ServiceName,
		Version: cfg.OTel.ServiceVersion,
		Env:     cfg.Env,
	})
	slog.SetDefault(logger)

	shutdownTracing, err := observability.SetupTracing(ctx, observability.TracingOptions{
		Enabled:        cfg.OTel.Enabled,
		ServiceName:    cfg.OTel.ServiceName,
		ServiceVersion: cfg.OTel.ServiceVersion,
		Env:            cfg.Env,
		Endpoint:       cfg.OTel.Endpoint,
		Insecure:       cfg.OTel.Insecure,
		SamplerRatio:   cfg.OTel.SamplerRatio,
	}, logger)
	if err != nil {
		return err
	}
	defer flushTracing(shutdownTracing, cfg.ShutdownTimeout, logger)

	deps := providers.Providers{}
{{if .HasPostgres}}	pool, err := postgres.Open(ctx, postgres.Config{
		DSN:         cfg.Postgres.DSN,
		MaxConns:    cfg.Postgres.MaxConns,
		ConnTimeout: cfg.Postgres.ConnTimeout,
	})
	if err != nil {
		return err
	}
	defer pool.Close()
	deps.Postgres = providers.NewPostgres(pool)
{{end}}
	checks, err := readinessChecks(cfg, deps)
	if err != nil {
		return err
	}

	uc := usecase.New(deps, checks, logger)
	api := server.New(uc, logger, httpmw.NewMetrics(), server.Options{
		Version: cfg.OTel.ServiceVersion,
	})

	httpServer := &http.Server{
		Addr:              cfg.HTTPAddr,
		Handler:           api.Router(cfg),
		ReadHeaderTimeout: cfg.ReadTimeout,
		ReadTimeout:       cfg.ReadTimeout,
		WriteTimeout:      cfg.WriteTimeout,
		IdleTimeout:       cfg.IdleTimeout,
		ErrorLog:          slog.NewLogLogger(logger.Handler(), slog.LevelError),
	}

	grpcServer := grpc.NewServer()
	server.RegisterGRPC(grpcServer, uc)
	reflection.Register(grpcServer)

	grpcLn, err := net.Listen("tcp", cfg.GRPCAddr)
	if err != nil {
		return err
	}

	serverErr := make(chan error, 1)
	go func() {
		logger.Info("http server listening",
			slog.String("addr", cfg.HTTPAddr),
			slog.String("service_id", cfg.ServiceID),
{{if .HasVault}}			slog.Bool("vault_enabled", cfg.Vault.Enabled),
{{end}}		)
		if err := httpServer.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			serverErr <- err
		}
	}()
	go func() {
		logger.Info("grpc server listening", slog.String("addr", cfg.GRPCAddr))
		if err := grpcServer.Serve(grpcLn); err != nil {
			serverErr <- err
		}
	}()

	select {
	case err := <-serverErr:
		stop()
		return err
	case <-ctx.Done():
		logger.Info("shutdown signal received", slog.String("grace", cfg.ShutdownTimeout.String()))
	}

	shutdownCtx, cancel := context.WithTimeout(context.Background(), cfg.ShutdownTimeout)
	defer cancel()

	stopped := make(chan struct{})
	go func() {
		grpcServer.GracefulStop()
		close(stopped)
	}()
	select {
	case <-stopped:
	case <-shutdownCtx.Done():
		grpcServer.Stop()
	}

	if err := httpServer.Shutdown(shutdownCtx); err != nil {
		logger.Error("graceful shutdown failed, closing connections", slog.Any("error", err))
		_ = httpServer.Close()
	}

	logger.Info("shutdown complete")
	return nil
}

func readinessChecks(cfg *config.Config, deps providers.Providers) ([]usecase.Check, error) {
	checks := []usecase.Check{}
{{if .HasPostgres}}	checks = append(checks, usecase.Check{Name: "postgres", Probe: deps.Postgres.Ping})
{{end}}{{if .HasVault}}	if cfg.Vault.Enabled {
		reader, err := config.NewVaultReader(cfg.Vault)
		if err != nil {
			return nil, err
		}
		checks = append(checks, usecase.Check{Name: "vault", Probe: reader.Ping})
	}
{{end}}	return checks, nil
}

func flushTracing(shutdown observability.ShutdownFunc, timeout time.Duration, logger *slog.Logger) {
	ctx, cancel := context.WithTimeout(context.Background(), timeout)
	defer cancel()

	if err := shutdown(ctx); err != nil {
		logger.Error("flush traces", slog.Any("error", err))
	}
}
